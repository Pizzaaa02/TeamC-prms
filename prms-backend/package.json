{
  "name": "backend",
  "version": "1.0.0",
  "description": "PRMS Backend",
  "main": "src/app.ts",
  "scripts": {
    "test": "jest --runInBand",
    "test:auth": "jest --runInBand --testPathPatterns=auth",
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "prisma:migrate": "npx prisma migrate dev --name init_migration",
    "prisma:generate": "npx prisma generate",
    "prisma:seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/config": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "latest",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pdfjs-dist": "^6.2.108",
    "sharp": "^0.35.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.3",
    "@types/uuid": "^10.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "prisma": "^7.8.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "@prisma/engines@7.10.0": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.12.2": true
  }
}
